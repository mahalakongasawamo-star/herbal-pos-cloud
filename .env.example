# Herbal POS Cloud: environment variables.
# Copy to .env.local (git-ignored) and fill in. Placeholders only; never commit real keys.
#
# Local stack: `npx supabase start`, then `npx supabase status` prints the API URL,
# the anon (publishable) key and the service_role (secret) key.
# Supabase Cloud: Dashboard > your project > Project Settings (or the "Connect" button).

# Project API URL.
# Cloud: Project Settings > Data API > Project URL (https://<project-ref>.supabase.co).
# Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public client key: the legacy "anon" key, or the newer publishable key (sb_publishable_...).
# Cloud: Project Settings > API Keys. Safe to ship to the browser: RLS decides what it can read.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER-ONLY secret: the legacy "service_role" key, or a secret key (sb_secret_...).
# Cloud: Project Settings > API Keys. It bypasses RLS entirely: never prefix it with
# NEXT_PUBLIC_, never import it into client code. Unused by the app in Phase 0.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
